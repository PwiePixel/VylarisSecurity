{
  "name": "vylarissecurity",
  "version": "1.0.0",
  "private": true,
  "description": "Vylaris Security – DNS-Server, Reverse-Proxy und IP-Verwaltung mit Cloudflare-Anbindung.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "node .next/standalone/server.js",
    "dns": "node engine/dns/main.ts",
    "proxy": "node engine/proxy/main.ts",
    "worker": "node engine/worker/main.ts",
    "test": "node --test \"tests/*.test.ts\" \"tests/*.test.mjs\""
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  },
  "type": "module"
}
